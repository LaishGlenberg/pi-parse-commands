{
	"name": "@lglen/pi-parse-commands",
	"version": "1.0.0",
	"type": "module",
	"description": "Split dense chained bash commands into a numbered breakdown box below the tool call",
	"keywords": ["pi-package", "pi", "extension", "bash"],
	"license": "MIT",
	"author": "LaishGlenberg",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LaishGlenberg/pi-parse-commands.git"
	},
	"homepage": "https://github.com/LaishGlenberg/pi-parse-commands#readme",
	"bugs": {
		"url": "https://github.com/LaishGlenberg/pi-parse-commands/issues"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"docs/**/*.md",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "22.19.19",
		"typescript": "^5.9.3",
		"oxlint": "^1.85.0",
		"vitest": "5.0.0"
	},
	"scripts": {
		"test": "vitest --run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings index.ts scripts test",
		"prepublishOnly": "npm test && npm run typecheck"
	}
}
